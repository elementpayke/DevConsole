# --- Server-only (never NEXT_PUBLIC_*) ---
# Shared secret with the aggregator. Required when FE_CLIENT_SECRET_REQUIRED=true.
# Injected by the Next.js BFF as X-FE-Client-Secret — must not appear in the browser bundle.
FE_CLIENT_SECRET=

# Partner API key used by the Off-ramp / merchant-onboarding BFF (server-only).
# Merchants are vault customers under this key; never expose to the browser.
CONSOLE_PARTNER_API_KEY=

# Aggregator API base used by the BFF proxy (src/app/api/proxy/[...path]/route.ts).
# Staging: https://sandbox.elementpay.net/api/v1
# Production: https://<live-aggregator-host>/api/v1
# Local aggregator: http://localhost:8000/api/v1
AGGREGATOR_BASE_URL=https://sandbox.elementpay.net/api/v1

# --- Client (safe to expose) ---
# Self-serve merchant register (Console). Leave unset/false until merchant KYB +
# collections are ready; developers can always register.
NEXT_PUBLIC_MERCHANT_SIGNUP_ENABLED=false
# Same Privy app as ElementPay dapp — one embedded wallet per user identity.
NEXT_PUBLIC_PRIVY_APP_ID=
# Which deployed instance this is — controls the "Sandbox mode" / "Live mode"
# badge shown in the console. Set to "live" only on the production deployment
# that points AGGREGATOR_BASE_URL at the live aggregator; any other value
# (or unset) shows as sandbox.
NEXT_PUBLIC_ENVIRONMENT=sandbox

# Cloudflare Turnstile site key (browser-safe). Pair with aggregator
# TURNSTILE_SECRET_KEY / TURNSTILE_REQUIRED. Leave empty until keys are ready;
# the widget is omitted when unset. Flip aggregator TURNSTILE_REQUIRED after FE ships.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Deprecated: browser no longer calls the aggregator directly.
# NEXT_PUBLIC_API_BASE_URL was removed in favor of the /api/proxy BFF.
